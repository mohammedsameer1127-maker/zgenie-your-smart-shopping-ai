# FastAPI Settings
PROJECT_NAME="ZGenie API"

# MongoDB Settings
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="zgenie"

# Firebase Settings
# Place your service account JSON file in the backend folder and reference it here
FIREBASE_CREDENTIALS_PATH="firebase-adminsdk.json"

# Groq Cloud AI Settings
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_API_URL="https://api.groq.com/openai/v1/chat/completions"

# Google OAuth & Gmail Settings
GOOGLE_CLIENT_ID="PASTE_MY_GOOGLE_CLIENT_ID_HERE"
GOOGLE_CLIENT_SECRET="PASTE_MY_GOOGLE_CLIENT_SECRET_HERE"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/gmail/callback"
FRONTEND_URL="http://localhost:8082"
GMAIL_ENCRYPTION_KEY="your_secure_encryption_key_here"

# Shopping Search Connectors (SerpApi & Serper.dev)
SERPAPI_KEY="your_serpapi_key_here"
SERPER_API_KEY="your_serper_api_key_here"
CONNECTOR_FALLBACK_ORDER="serper,serpapi"
ENABLE_DEBUG_ROUTES="true"

